          },
          "refId": "A",
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT COALESCE(SUM(spc.netAmount), 0) FROM settlementParticipantCurrency spc JOIN settlement s ON s.settlementId = spc.settlementId JOIN settlementStateChange sc ON sc.settlementStateChangeId = s.currentStateChangeId WHERE sc.settlementStateId = 'SETTLED' AND spc.netAmount > 0 AND $__timeFilter(s.createdDate)"
        }
