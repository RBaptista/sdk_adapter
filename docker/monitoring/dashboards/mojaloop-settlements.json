    {
      "type": "timeseries",
      "title": "Net debit position per DFSP",
      "description": "The hub position of each DFSP (positive = owes the scheme). Settling a window with autoPositionReset moves it back by the settled net amount. Annotations: window closes and settled settlements.",
      "id": 15,
      "datasource": {
        "type": "mysql",
        "uid": "e6f1763f-dc6a-4521-8254-0dbe1515b837"
      },
      "gridPos": {
        "h": 9,
        "w": 16,
        "x": 0,
        "y": 10
      },
      "targets": [
        {
          "datasource": {
            "type": "mysql",
            "uid": "e6f1763f-dc6a-4521-8254-0dbe1515b837"
          },
          "refId": "A",
          "rawQuery": true,
          "editorMode": "code",
          "format": "time_series",
          "rawSql": "SELECT ppc.createdDate AS time, p.name AS metric, ppc.value AS position FROM participantPositionChange ppc JOIN participantPosition pp ON pp.participantPositionId = ppc.participantPositionId JOIN participantCurrency pc ON pc.participantCurrencyId = pp.participantCurrencyId JOIN participant p ON p.participantId = pc.participantId WHERE pc.ledgerAccountTypeId = (SELECT ledgerAccountTypeId FROM ledgerAccountType WHERE name = 'POSITION') AND $__timeFilter(ppc.createdDate) ORDER BY ppc.createdDate"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "min",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "stepAfter",
            "lineWidth": 1,
            "fillOpacity": 15,
            "showPoints": "never",
            "barAlignment": 0,
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "spanNulls": true
          }
        },
        "overrides": []
      }
    },
