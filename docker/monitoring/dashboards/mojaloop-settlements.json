    {
      "type": "stat",
      "title": "Net volume settled (range)",
      "description": "Sum of the net amounts debtor DFSPs paid in settled settlements (equal to what creditors received).",
      "id": 9,
      "datasource": {
        "type": "mysql",
        "uid": "e6f1763f-dc6a-4521-8254-0dbe1515b837"
