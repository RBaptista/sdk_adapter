          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT p.name AS dfsp, pc.currencyId AS currency, pos.value AS position, lim.value AS ndc, ROUND(100 * GREATEST(pos.value, 0) / NULLIF(lim.value, 0), 1) AS `ndc used %`, -stl.value AS `settlement balance`, -stl.value - pos.value AS `liquidity left` FROM participant p JOIN participantCurrency pc ON pc.participantId = p.participantId AND pc.ledgerAccountTypeId = (SELECT ledgerAccountTypeId FROM ledgerAccountType WHERE name = 'POSITION') JOIN participantPosition pos ON pos.participantCurrencyId = pc.participantCurrencyId LEFT JOIN participantLimit lim ON lim.participantCurrencyId = pc.participantCurrencyId AND lim.isActive = 1 LEFT JOIN participantCurrency sc ON sc.participantId = p.participantId AND sc.currencyId = pc.currencyId AND sc.ledgerAccountTypeId = (SELECT ledgerAccountTypeId FROM ledgerAccountType WHERE name = 'SETTLEMENT') LEFT JOIN participantPosition stl ON stl.participantCurrencyId = sc.participantCurrencyId WHERE p.name <> 'Hub' ORDER BY p.name"
        }
      ],
