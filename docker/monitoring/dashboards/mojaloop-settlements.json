          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT s.settlementId AS settlement, sc.settlementStateId AS state, sm.name AS model, (SELECT GROUP_CONCAT(ssw.settlementWindowId ORDER BY ssw.settlementWindowId) FROM settlementSettlementWindow ssw WHERE ssw.settlementId = s.settlementId) AS windows, s.createdDate AS created, sc.createdDate AS `last change`, TIMESTAMPDIFF(SECOND, s.createdDate, sc.createdDate) AS `duration s`, (SELECT COUNT(*) FROM settlementParticipantCurrency spc WHERE spc.settlementId = s.settlementId) AS accounts, (SELECT SUM(GREATEST(spc.netAmount, 0)) FROM settlementParticipantCurrency spc WHERE spc.settlementId = s.settlementId) AS `net volume`, s.reason FROM settlement s JOIN settlementStateChange sc ON sc.settlementStateChangeId = s.currentStateChangeId JOIN settlementModel sm ON sm.settlementModelId = s.settlementModelId WHERE $__timeFilter(s.createdDate) ORDER BY s.settlementId DESC LIMIT 100"
