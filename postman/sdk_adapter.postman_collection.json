                "dfsps",
                "{{fspId}}"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"displayName\": \"New DFSP\",\n  \"sdkOutboundUrl\": \"{{sdkOutboundUrl}}\",\n  \"netDebitCap\": 2000000\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Null fields keep their value. A changed sdkInboundUrl takes effect at the next onboarding."
          },
          "response": []
        },
        {
          "name": "onboard dfsp in the hub",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{url}}/api/admin/dfsps/{{fspId}}/onboard",
              "host": [
                "{{url}}"
              ],
              "path": [
                "api",
                "admin",
                "dfsps",
                "{{fspId}}",
                "onboard"
              ]
            },
            "description": "Creates the participant in central-ledger with its NDC limit, registers the 11 callback endpoints pointing at the DFSP's SDK inbound API, activates it and records the initial funds (only once). Safe to repeat."
          },
          "response": []
        }
      ],
      "description": "Needs the `admin` role: log in as sdk-admin."
