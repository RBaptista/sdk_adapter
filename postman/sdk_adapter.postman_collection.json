            "body": {
              "mode": "raw",
              "raw": "{\n  \"fspId\": \"{{fspId}}\",\n  \"displayName\": \"New DFSP\",\n  \"currency\": \"CVE\",\n  \"sdkOutboundUrl\": \"{{sdkOutboundUrl}}\",\n  \"netDebitCap\": 1000000,\n  \"initialPosition\": 0,\n  \"initialFunds\": 1000000\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Creates a hosted DFSP. `sdkOutboundUrl` is the outbound API of its SDK scheme adapter, which must already run (add it to docker/sdk/docker-compose.yml). `sdkInboundUrl` is optional and defaults to http://<fspId>-sdk:4000, the address the hub uses for the DFSP's callbacks. A Keycloak user with fsp_id = fspId is needed to operate it."
          },
          "response": []
        },
